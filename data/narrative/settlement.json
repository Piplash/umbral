  "dialogues": {
    "lira": {
      "speaker": "Lira",
      "art": "support",
      "lines": [
        "El generador vuelve a fallar. En la ciudad ni siquiera se enterarán.",
        "Si nosotros no cuidamos a la gente de aquí, ¿quién lo hará?"
      ],
      "choices": [
        {
          "text": "No podemos salvar a todos. Pero empezaremos por aquí."
        }
      ]
    },
    "villager": {
      "speaker": "Aldeano",
      "art": "civil",
      "lines": [
        "Gael, se han escuchado rumores de que las tropas de la Autoridad están acercándose al asentamiento. ¿Crees que sea cierto?"
      ],
      "choices": [
        {
          "text": "Tranquilo, son solo rumores. No va a pasar nada.",
          "effects": [
            {
              "bucket": "flags",
              "key": "villager_warned",
              "value": false
            },
            {
              "bucket": "choices",
              "key": "villager_response",
              "value": "reassure"
            }
          ]
        },
        {
          "text": "Si es cierto, debemos estar preparados. Refúgiate en el viejo almacén si ocurre algo. Nosotros nos haremos cargo.",
          "effects": [
            {
              "bucket": "flags",
              "key": "villager_warned",
              "value": true
            },
            {
              "bucket": "choices",
              "key": "villager_response",
              "value": "warn"
            }
          ]
        }
      ]
    },
    "neighbor": {
      "speaker": "Habitante",
      "art": "civil",
      "lines": [
        "Las caravanas ya no regresan del norte. Dicen que la Autoridad se lleva a quienes no pueden pagar energía.",
        "Yo solo sé que cada invierno quedan menos luces encendidas."
      ],
      "choices": [
        {
          "text": "Gracias. Tendremos cuidado."
        }
      ]
    },
    "terminal": {
      "speaker": "Terminal defensiva",
      "lines": [
        "Un relé oxidado aún conserva carga. Podría alimentar una barrera junto al acceso oriental."
      ],
      "choices": [
        {
          "text": "Activar defensas.",
          "effects": [
            {
              "bucket": "prepared",
              "key": "terminal"
            }
          ]
        },
        {
          "text": "Dejarlo como está."
        }
      ],
      "examined_id": "terminal"
    },
    "ruins": {
      "speaker": "Conducto",
      "lines": [
        "Bajo el musgo aún vibra una tubería. El pueblo vive de maquinaria que ya nadie sabe reparar."
      ],
      "choices": [
        {
          "text": "Volver.",
          "effects": [
            {
              "bucket": "examined",
              "key": "ruins"
            }
          ]
        }
      ],
      "examined_id": "ruins"
    },
    "woman_a": {
      "speaker": "Elena",
      "lines": [
        "El huerto nos da menos cada año. Al menos aún podemos compartirlo."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    },
    "woman_b": {
      "speaker": "Mara",
      "lines": [
        "Hay que repartir las provisiones antes de que anochezca."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    },
    "worker_a": {
      "speaker": "Reparador",
      "lines": [
        "Este relé lleva reparaciones de tres generaciones. No durará mucho más."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    },
    "worker_b": {
      "speaker": "Transportista",
      "lines": [
        "Si se corta el camino, estas cajas serán todo lo que nos quede."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    },
    "elder": {
      "speaker": "Vecino mayor",
      "lines": [
        "Cuando el pueblo se reúne, las noches pesan menos."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    },
    "child": {
      "speaker": "Niño",
      "lines": [
        "Lira dice que las luces del norte se ven hasta desde el bosque."
      ],
      "choices": [
        {
          "text": "Volver."
        }
      ]
    }
  },
