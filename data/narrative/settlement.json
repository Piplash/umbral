  "dialogues": {
    "lira": {
      "speaker": "Lira",
      "art": "support",
      "lines": [
        "El generador vuelve a fallar. En la ciudad ni siquiera se enterarán.",
        "Si nosotros no cuidamos a la gente de aquí, ¿quién lo hará?"
      ],
      "choices": [
        {
          "text": "No podemos salvar a todos. Pero empezaremos por aquí."
        }
      ]
    },
    "villager": {
      "speaker": "Aldeano",
      "art": "civil",
      "lines": [
        "Gael, se han escuchado rumores de que las tropas de la Autoridad están acercándose al asentamiento. ¿Crees que sea cierto?"
      ],
      "choices": [
        {
          "text": "Tranquilo, son solo rumores. No va a pasar nada.",
          "effects": [
            {
              "bucket": "flags",
              "key": "villager_warned",
              "value": false
            },
            {
              "bucket": "choices",
              "key": "villager_response",
              "value": "reassure"
            }
          ]
        },
        {
          "text": "Si es cierto, debemos estar preparados. Refúgiate en el viejo almacén si ocurre algo. Nosotros nos haremos cargo.",
          "effects": [
            {
              "bucket": "flags",
              "key": "villager_warned",
              "value": true
            },
            {
              "bucket": "choices",
              "key": "villager_response",
              "value": "warn"
            }
          ]
        }
      ]
    },
    "neighbor": {
      "speaker": "Habitante",
      "art": "civil",
      "lines": [
        "Las caravanas ya no regresan del norte. Dicen que la Autoridad se lleva a quienes no pueden pagar energía.",
        "Yo solo sé que cada invierno quedan menos luces encendidas."
      ],
      "choices": [
        {
          "text": "Gracias. Tendremos cuidado."
        }
      ]
    },
    "terminal": {
      "speaker": "Terminal defensiva",
      "lines": [
        "Un relé oxidado aún conserva carga. Podría alimentar una barrera junto al acceso oriental."
      ],
      "choices": [
        {
          "text": "Activar defensas.",
          "effects": [
            {
              "bucket": "prepared",
              "key": "terminal"
            }
          ]
        },
        {
          "text": "Dejarlo como está."
        }
      ],
      "examined_id": "terminal"
    },
    "ruins": {
      "speaker": "Conducto",
      "lines": [
        "Bajo el musgo aún vibra una tubería. El pueblo vive de maquinaria que ya nadie sabe reparar."
      ],
      "choices": [
        {
          "text": "Volver.",
          "effects": [
